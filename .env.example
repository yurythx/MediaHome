# Configurações de Ambiente - Stack MediaHome
# Ubuntu 24.04 + aaPanel
#
# COMO USAR:
#   1. Copie este arquivo para ".env" (o Docker Compose carrega ".env" automaticamente):
#        cp .env.example .env
#   2. Edite o ".env" com os valores reais do seu servidor.
#   3. NUNCA commite o arquivo ".env" - ele já está no .gitignore.
#
# Todos os arquivos docker-compose (jellyfin/, komga/, navidrome/, fileserver/,
# portainer/, qbittorrent/, peertube/) leem estas variáveis. Se uma variável não
# existir no ".env", o valor padrão (após o ":-") é usado - exceto SAMBA_PASSWORD
# e as variáveis do PeerTube marcadas abaixo, que são obrigatórias e não têm
# padrão por segurança (o serviço recusa subir sem elas).

# ===========================================
# CONFIGURAÇÕES GERAIS
# ===========================================
# IP do servidor Ubuntu (ajustar conforme necessário)
HOST_IP=192.168.0.121

# Timezone
TZ=America/Sao_Paulo

# Usuário e grupo para containers
PUID=1000
PGID=1000

# ===========================================
# CONFIGURAÇÕES SAMBA
# ===========================================
# Usuário e senha para acesso Samba - DEFINA UMA SENHA FORTE, não deixe em branco
SAMBA_USER=suporte
SAMBA_PASSWORD=troque_esta_senha_por_uma_forte

# ===========================================
# CONFIGURAÇÕES PEERTUBE
# ===========================================
# ATENÇÃO: PEERTUBE_HOSTNAME é DEFINITIVO após o primeiro "docker compose up".
# Trocar depois exige apagar o volume do Postgres do PeerTube e recomeçar do
# zero. Defina o domínio final ANTES de subir este serviço pela primeira vez.
PEERTUBE_HOSTNAME=clips.seudominio.com
PEERTUBE_ADMIN_EMAIL=admin@seudominio.com
# Gere com: openssl rand -hex 32
PEERTUBE_SECRET=troque_por_um_valor_gerado_com_openssl_rand_hex_32
PEERTUBE_DB_USERNAME=peertube
PEERTUBE_DB_PASSWORD=troque_esta_senha_por_uma_forte

# ===========================================
# CONFIGURAÇÕES DE VOLUMES
# ===========================================
# Caminhos dos volumes no host Ubuntu
CONFIG_PATH=/mnt/config
MEDIA_PATH_1=/mnt/dados
MEDIA_PATH_2=/mnt/dados2
MEDIA_PATH_EXT=/mnt/externo

# ===========================================
# CONFIGURAÇÕES DE REDE
# ===========================================
# Rede Docker para comunicação entre serviços
DOCKER_NETWORK=mediahome

# ===========================================
# CONFIGURAÇÕES DE PORTAS
# ===========================================
# Portas expostas no host
JELLYFIN_PORT=8096
KOMGA_PORT=8082
NAVIDROME_PORT=4533
SAMBA_PORT=445
PORTAINER_PORT=9020
QBITTORRENT_PORT=8080
QBITTORRENT_PORT_TORRENT=6881
PEERTUBE_PORT=9000

# ===========================================
# CONFIGURAÇÕES DE DOMÍNIOS (aaPanel)
# ===========================================
# Configure estes domínios no aaPanel com proxy reverso
# jellyfin.seudominio.com → HOST_IP:JELLYFIN_PORT
# komga.seudominio.com → HOST_IP:KOMGA_PORT
# navidrome.seudominio.com → HOST_IP:NAVIDROME_PORT
# portainer.seudominio.com → HOST_IP:PORTAINER_PORT
# torrent.seudominio.com → HOST_IP:QBITTORRENT_PORT
# PEERTUBE_HOSTNAME (ex: clips.seudominio.com) → HOST_IP:PEERTUBE_PORT

# ===========================================
# INSTRUÇÕES DE USO
# ===========================================
# 1. Crie a estrutura de diretórios:
#    sudo mkdir -p /mnt/dados/{filmes,series,musicas,quadrinhos}
#    sudo mkdir -p /mnt/dados2/{filmes,series,musicas,quadrinhos}
#    sudo mkdir -p /mnt/externo
#    sudo mkdir -p /mnt/config/{jellyfin,komga,navidrome,portainer,qbittorrent}
#    sudo mkdir -p /mnt/config/peertube/{data,config,postgres,redis}
#
# 2. Configure permissões:
#    sudo chown -R 1000:1000 /mnt/config /mnt/dados /mnt/dados2 /mnt/externo
#    sudo chmod -R 755 /mnt/config /mnt/dados /mnt/dados2 /mnt/externo
#
# 3. Configure domínios no aaPanel com proxy reverso
#
# 4. Configure SSL para todos os domínios
#
# 5. Execute: docker compose up -d

# ===========================================
# ESTRUTURA DE MÍDIA RECOMENDADA
# ===========================================
# /mnt/dados/
# ├── filmes/
# │   └── Nome do Filme (Ano)/
# │       └── arquivo.mkv
# ├── series/
# │   └── Nome da Serie/
# │       └── Season XX/
# │           └── episodios.mkv
# ├── musicas/
# │   └── Artista/
# │       └── Album/
# │           └── faixas.mp3
# └── quadrinhos/
#     └── Editora/
#         └── Serie/
#             └── arquivos.cbz
